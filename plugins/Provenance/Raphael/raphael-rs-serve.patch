+
+impl PreparedMacroSolver<'_, '_, '_> {
+    /// Solves from an arbitrary (mid-craft) state, assuming Normal conditions from here on.
+    pub fn solve_from(&mut self, state: SimulationState) -> Result<Vec<Action>, SolverException> {
+        self.solve_from_condition(state, Condition::Normal)
+    }
+
+    /// Solves from `state` where the next step has `condition` (Good/Excellent also enable
+    /// Precise Touch, Tricks of the Trade and Intensive Synthesis); later steps are assumed Normal.
+    /// The first returned action is meant to be used under `condition`.
+    pub fn solve_from_condition(
+        &mut self,
+        state: SimulationState,
+        condition: Condition,
+    ) -> Result<Vec<Action>, SolverException> {
+        let _timer = ScopedTimer::new("Search");
+        let solver = &mut *self.macro_solver;
+        // A mid-craft state can carry a touch combo, which the FinishSolver never stores (the
+        // search resets combos after every ActionCombo). Combos don't affect progress actions.
+        let mut finish_state = state;
+        if finish_state.effects.combo() != Combo::SynthesisBegin {
+            finish_state.effects.set_combo(Combo::None);
+        }
+        if !solver.finish_solver.can_finish(&finish_state)? {
+            solver.last_solve_runtime_stats.finish_solver_stats =
+                solver.finish_solver.runtime_stats();
+            return Err(SolverException::NoSolution);
+        }
+        let solution =
+            solver.do_solve(&mut self.quality_ub_solver, &mut self.step_lb_solver, state, condition)?;
+        log::debug!("{:?}", solver.runtime_stats());
+        Ok(solution.actions())
+    }
+}
