@@ -0,0 +1,353 @@
+//! `serve`: a long-running solver for re-planning the rest of a craft.
+//!
+//! A line protocol on stdin/stdout. Once started it prints `serve 1` (the protocol version). Then:
+//!
+//! * `prepare <solve arguments>`: the same arguments as `solve` (recipe, stats, level, Manipulation,
+//!   specialist actions, HQ ingredients / initial quality, target quality, food, potion...; `--threads`
+//!   and `--output-variables` are ignored). Runs the solver's precomputes once and keeps them.
+//!   Answers `ready <ms> <initial_quality> <recipe_max_quality> "<settings>"` (settings as `solve`
+//!   prints them) or `error <message>`. A new `prepare` replaces the previous one.
+//! * `solve <id> <condition> cp=.. durability=.. progress=.. quality=.. inner_quiet=.. waste_not=..
+//!   innovation=.. veneration=.. great_strides=.. muscle_memory=.. manipulation=..
+//!   trained_perfection_available=0|1 heart_and_soul_available=0|1 quick_innovation_available=0|1
+//!   trained_perfection_active=0|1 heart_and_soul_active=0|1 combo=none|begin|basic|standard`:
+//!   the rest of the rotation from that state, where the next step has `<condition>` (normal, good,
+//!   excellent, poor) and every later one is assumed Normal. `quality` doesn't count the initial
+//!   quality (as the simulator has it). Answers `solved <id> <ms> [<action ids>]` (ids as `solve`'s
+//!   `action_ids`), `nosolution <id> <ms>` or `error <id> <message>`.
+//! * `cancel <id>`: interrupts that solve if it is still running (it then answers `error <id> Interrupted`).
+//! * `quit`, or the end of stdin: exits at once.
+//!
+//! Errors are always one line. Everything else (logs) goes to stderr. Release builds abort on a panic: the
+//! process then ends, which the client sees as its stdout closing.
+
+use std::io::{BufRead, Write};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::mpsc::{Receiver, channel};
+use std::time::Instant;
+
+use clap::{Args, Parser};
+use raphael_data::{MEALS, POTIONS, RECIPES};
+use raphael_sim::{Combo, Condition, Effects, SimulationState, SpecialQualityState};
+use raphael_solver::{AtomicFlag, BumpPool, MacroSolver, SolverException, SolverSettings};
+
+use super::solve::{ConsumableArg, SolveArgs, setup};
+
+pub const PROTOCOL_VERSION: u32 = 1;
+
+#[derive(Args, Debug)]
+pub struct ServeArgs {
+    /// Maximum number of threads available to the solver
+    #[arg(long)]
+    pub threads: Option<usize>,
+}
+
+#[derive(Parser, Debug)]
+#[command(name = "prepare")]
+struct PrepareLine {
+    #[command(flatten)]
+    args: SolveArgs,
+}
+
+/// Shared with the stdin reader: the id of the solve running now (0: none) and its interrupt flag.
+struct Control {
+    running: AtomicU64,
+    interrupt: AtomicFlag,
+}
+
+fn answer(line: &str) {
+    let mut out = std::io::stdout().lock();
+    let _ = writeln!(out, "{line}");
+    let _ = out.flush();
+}
+
+fn one_line(text: &str) -> String {
+    text.lines()
+        .map(str::trim)
+        .filter(|l| !l.is_empty())
+        .collect::<Vec<_>>()
+        .join(" | ")
+}
+
+/// What `solve` would panic on (release builds abort on a panic), as an error instead.
+fn check(args: &SolveArgs) -> Result<(), String> {
+    if args.recipe_id.is_none() && args.item_id.is_none() && args.custom_recipe.is_empty() {
+        return Err("one of --recipe-id, --item-id or --custom-recipe is needed".to_owned());
+    }
+    if let Some(id) = args.recipe_id
+        && RECIPES.get(id).is_none()
+    {
+        return Err(format!("no recipe with id {id}"));
+    }
+    if args.recipe_id.is_none()
+        && args.custom_recipe.is_empty()
+        && let Some(id) = args.item_id
+        && !RECIPES.values().any(|r| r.item_id == id)
+    {
+        return Err(format!("no recipe for item {id}"));
+    }
+    let known = |list: &[raphael_data::Consumable], arg: Option<ConsumableArg>| match arg {
+        Some(ConsumableArg::NQ(id)) => list.iter().any(|c| c.item_id == id && !c.hq),
+        Some(ConsumableArg::HQ(id)) => list.iter().any(|c| c.item_id == id && c.hq),
+        None => true,
+    };
+    if !known(MEALS, args.food) {
+        return Err("unknown food".to_owned());
+    }
+    if !known(POTIONS, args.potion) {
+        return Err("unknown potion".to_owned());
+    }
+    Ok(())
+}
+
+pub fn execute(args: &ServeArgs) {
+    if let Some(threads) = args.threads {
+        // The only pool: every prepare and solve runs on it.
+        let _ = rayon::ThreadPoolBuilder::new()
+            .num_threads(threads)
+            .build_global();
+    }
+    let control = Arc::new(Control {
+        running: AtomicU64::new(0),
+        interrupt: AtomicFlag::new(),
+    });
+    let (tx, rx) = channel::<String>();
+    {
+        let control = control.clone();
+        std::thread::spawn(move || {
+            let stdin = std::io::stdin();
+            for line in stdin.lock().lines() {
+                let Ok(line) = line else { break };
+                let trimmed = line.trim();
+                if trimmed == "quit" {
+                    std::process::exit(0);
+                }
+                if let Some(id) = trimmed.strip_prefix("cancel ") {
+                    if let Ok(id) = id.trim().parse::<u64>()
+                        && id != 0
+                        && control.running.load(Ordering::SeqCst) == id
+                    {
+                        control.interrupt.set();
+                    }
+                    continue;
+                }
+                if tx.send(line).is_err() {
+                    break;
+                }
+            }
+            // stdin closed: whoever started us is gone.
+            std::process::exit(0);
+        });
+    }
+
+    answer(&format!("serve {PROTOCOL_VERSION}"));
+    let mut next: Option<String> = None;
+    loop {
+        let line = match next.take() {
+            Some(line) => line,
+            None => match rx.recv() {
+                Ok(line) => line,
+                Err(_) => return,
+            },
+        };
+        let line = line.trim();
+        let (command, rest) = line.split_once(' ').unwrap_or((line, ""));
+        match command {
+            "" => {}
+            "prepare" => next = prepared_session(rest, &rx, &control),
+            "solve" => {
+                let id = rest.split_whitespace().next().unwrap_or("0");
+                answer(&format!("error {id} not prepared"));
+            }
+            _ => answer(&format!("error unknown command {command}")),
+        }
+    }
+}
+
+/// Prepares a solver and answers `solve` lines with it until another command comes; returns that command.
+fn prepared_session(rest: &str, rx: &Receiver<String>, control: &Control) -> Option<String> {
+    let started = Instant::now();
+    let argv = std::iter::once("prepare").chain(rest.split_whitespace());
+    let args = match PrepareLine::try_parse_from(argv) {
+        Ok(line) => line.args,
+        Err(e) => {
+            answer(&format!("error {}", one_line(&e.to_string())));
+            return None;
+        }
+    };
+    if let Err(e) = check(&args) {
+        answer(&format!("error {e}"));
+        return None;
+    }
+    let setup = setup(&args);
+    let settings = setup.settings;
+    let allocator = BumpPool::default();
+    control.interrupt.clear();
+    let mut solver = MacroSolver::new(
+        SolverSettings {
+            simulator_settings: settings,
+            allow_non_max_quality_solutions: true,
+        },
+        Box::new(|_| {}),
+        Box::new(|_| {}),
+        control.interrupt.clone(),
+    );
+    let mut prepared = match solver.prepare(&allocator) {
+        Ok(prepared) => prepared,
+        Err(e) => {
+            answer(&format!("error {}", one_line(&format!("{e:?}"))));
+            return None;
+        }
+    };
+    answer(&format!(
+        "ready {} {} {} \"{:?}\"",
+        started.elapsed().as_millis(),
+        setup.initial_quality,
+        setup.recipe_max_quality,
+        settings
+    ));
+
+    loop {
+        let line = rx.recv().ok()?;
+        let trimmed = line.trim();
+        let (command, rest) = trimmed.split_once(' ').unwrap_or((trimmed, ""));
+        if command.is_empty() {
+            continue;
+        }
+        if command == "prepare" {
+            return Some(line);
+        }
+        if command != "solve" {
+            answer(&format!("error unknown command {command}"));
+            continue;
+        }
+        let mut words = rest.split_whitespace();
+        let id = words
+            .next()
+            .and_then(|w| w.parse::<u64>().ok())
+            .unwrap_or(0);
+        if id == 0 {
+            answer("error 0 a solve needs an id above 0");
+            continue;
+        }
+        let request = match parse_request(words, &settings) {
+            Ok(request) => request,
+            Err(e) => {
+                answer(&format!("error {id} {e}"));
+                continue;
+            }
+        };
+        let started = Instant::now();
+        control.interrupt.clear();
+        control.running.store(id, Ordering::SeqCst);
+        let result = prepared.solve_from_condition(request.0, request.1);
+        control.running.store(0, Ordering::SeqCst);
+        let ms = started.elapsed().as_millis();
+        match result {
+            Ok(actions) => {
+                let ids: Vec<u32> = actions.iter().map(|a| a.action_id()).collect();
+                answer(&format!("solved {id} {ms} {ids:?}"));
+            }
+            Err(SolverException::NoSolution) => answer(&format!("nosolution {id} {ms}")),
+            Err(e) => answer(&format!("error {id} {}", one_line(&format!("{e:?}")))),
+        }
+    }
+}
+
+fn flag(value: &str) -> Result<bool, String> {
+    match value {
+        "0" => Ok(false),
+        "1" => Ok(true),
+        _ => Err(format!("{value} isn't 0 or 1")),
+    }
+}
+
+/// Reads `<condition> key=value...` into the state to solve from and the next step's condition.
+fn parse_request<'a>(
+    mut words: impl Iterator<Item = &'a str>,
+    settings: &raphael_sim::Settings,
+) -> Result<(SimulationState, Condition), String> {
+    let condition = match words.next().unwrap_or("") {
+        "normal" => Condition::Normal,
+        "good" => Condition::Good,
+        "excellent" => Condition::Excellent,
+        "poor" => Condition::Poor,
+        other => return Err(format!("unknown condition '{other}'")),
+    };
+    const KEYS: [&str; 17] = [
+        "cp",
+        "durability",
+        "progress",
+        "quality",
+        "inner_quiet",
+        "waste_not",
+        "innovation",
+        "veneration",
+        "great_strides",
+        "muscle_memory",
+        "manipulation",
+        "trained_perfection_available",
+        "heart_and_soul_available",
+        "quick_innovation_available",
+        "trained_perfection_active",
+        "heart_and_soul_active",
+        "combo",
+    ];
+    let mut values: [Option<&str>; 17] = [None; 17];
+    for word in words {
+        let (key, value) = word
+            .split_once('=')
+            .ok_or_else(|| format!("'{word}' isn't key=value"))?;
+        let i = KEYS
+            .iter()
+            .position(|k| *k == key)
+            .ok_or_else(|| format!("unknown key '{key}'"))?;
+        values[i] = Some(value);
+    }
+    let get = |i: usize| values[i].ok_or_else(|| format!("{} is missing", KEYS[i]));
+    let number = |i: usize, most: u16| -> Result<u16, String> {
+        let n: u16 = get(i)?
+            .parse()
+            .map_err(|_| format!("{} isn't a number", KEYS[i]))?;
+        if n > most {
+            return Err(format!("{} {n} is above {most}", KEYS[i]));
+        }
+        Ok(n)
+    };
+    let small = |i: usize, most: u16| number(i, most).map(|n| n as u8);
+    let combo = match get(16)? {
+        "none" => Combo::None,
+        "begin" => Combo::SynthesisBegin,
+        "basic" => Combo::BasicTouch,
+        "standard" => Combo::StandardTouch,
+        other => return Err(format!("unknown combo '{other}'")),
+    };
+    let effects = Effects::new()
+        .with_inner_quiet(small(4, 10)?)
+        .with_waste_not(small(5, 8)?)
+        .with_innovation(small(6, 4)?)
+        .with_veneration(small(7, 4)?)
+        .with_great_strides(small(8, 3)?)
+        .with_muscle_memory(small(9, 5)?)
+        .with_manipulation(small(10, 8)?)
+        .with_trained_perfection_available(flag(get(11)?)?)
+        .with_heart_and_soul_available(flag(get(12)?)?)
+        .with_quick_innovation_available(flag(get(13)?)?)
+        .with_trained_perfection_active(flag(get(14)?)?)
+        .with_heart_and_soul_active(flag(get(15)?)?)
+        .with_special_quality_state(SpecialQualityState::Normal)
+        .with_combo(combo);
+    let state = SimulationState {
+        cp: number(0, settings.max_cp)?,
+        durability: number(1, settings.max_durability)?,
+        progress: number(2, u16::MAX)?,
+        quality: number(3, u16::MAX)?,
+        unreliable_quality: 0,
+        effects,
+    };
+    if state.is_final(settings) {
+        return Err("the state is final".to_owned());
+    }
+    Ok((state, condition))
+}
