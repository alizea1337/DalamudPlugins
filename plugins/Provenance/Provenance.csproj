<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.21.1.0</Version>
    <Author>alizea1337</Author>
    <Name>Provenance</Name>
    <Punchline>Turns a Teamcraft list into finished items: gathers, fishes, buys and crafts every material for you.</Punchline>
    <Description>Provenance takes a Teamcraft list (link, copied text or import string) or items you pick in its recipe browser, works out every material down to the crystals, then gets everything and crafts it in one run: items from your retainers, master books and folklore tomes from scrip exchanges (earning the scrips with collectables when needed), vendors, monster drops with a basic combo, its own gathering including timed nodes and collectables, its own fishing and spearfishing including mooch chains, Fisher's Intuition and fish windows, and crafting with Raphael rotations. No market board. Requires vnavmesh. Open /provenance to get started.</Description>
    <RepoUrl>https://github.com/alizea1337/DalamudPlugins</RepoUrl>
    <Tags>crafting;gathering;fishing;teamcraft;automation</Tags>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>Provenance</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\Fonts\*.ttf;Resources\Fonts\LICENSE-*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <!-- Built from raphael-rs by the release workflow; absent in local builds (GatherBuddy Reborn's copy is used then). -->
    <Content Include="Resources/raphael-cli.exe" Link="raphael-cli.exe" Condition="Exists('Resources/raphael-cli.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="Resources/LICENSE-raphael.txt" Condition="Exists('Resources/LICENSE-raphael.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <EmbeddedResource Include="Resources/vendors.json" LogicalName="Provenance.Resources.vendors.json" />
    <EmbeddedResource Include="Resources/mobs.json" LogicalName="Provenance.Resources.mobs.json" />
    <EmbeddedResource Include="Resources/reduction.json" LogicalName="Provenance.Resources.reduction.json" />
    <EmbeddedResource Include="Resources/nodes.json" LogicalName="Provenance.Resources.nodes.json" />
    <EmbeddedResource Include="Resources/fish.json" LogicalName="Provenance.Resources.fish.json" />
    <EmbeddedResource Include="Resources/fishspots.json" LogicalName="Provenance.Resources.fishspots.json" />
    <EmbeddedResource Include="Resources/ilvconvert.csv" LogicalName="Provenance.Resources.ilvconvert.csv" />
    <Content Include="NOTICE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="images\icon.png" Condition="Exists('images\icon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.2.1.26" />
  </ItemGroup>
</Project>
